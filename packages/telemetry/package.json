    "index.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pureooze/pi-config.git",
    "directory": "packages/telemetry"
  },
  "bugs": {
    "url": "https://github.com/pureooze/pi-config/issues"
  },
  "homepage": "https://github.com/pureooze/pi-config/tree/main/packages/telemetry",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
